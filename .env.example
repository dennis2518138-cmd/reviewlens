# 复制成 .env 后填自己的值；.env 不要提交
# 走 OpenAI 兼容中转（本机没有官方 api.deepseek.com 的 key）
LLM_BASE_URL=https://api.tokenjuice.ai/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：LangSmith 全链路追踪（D9 截图用）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=reviewlens

SQLITE_PATH=./data/reviewlens.db
CHROMA_PATH=./data/chroma
